<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gestión de Plazas Vacantes</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestionPlazasVacantes.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        .tree-toggle::after {
            content: "\F282";
            font-family: "bootstrap-icons";
            margin-left: auto;
            transition: transform 0.2s;
        }

        .tree-toggle.collapsed::after {
            transform: rotate(-90deg);
        }

        .collapse .nav-link { padding-left: 1.8rem; }
        .collapse .collapse .nav-link { padding-left: 2.8rem; }

        .disabled-link {
            opacity: 0.5;
            pointer-events: none;
        }

        .badge-count {
            margin-left: auto;
            background: #6c757d;
        }

        .sidebar {
            height: 100vh;
            overflow-y: auto;
        }

        .sidebar {
            height: 100vh;
            overflow-y: auto;
            position: sticky;
            top: 0;
        }

        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.2);
            border-radius: 10px;
        }
    </style>
</head>

<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        bool esPlazas =
        controller == "Plazas" ||
        controller == "Asignaciones" ||
        controller == "PlazasInternas" ||
        controller == "Postulacion";

        bool esReporteria =
        controller == "Dashboard" ||
        controller == "Reportes";

        // 🔥 Simulación de contadores (luego backend)
        int totalPlazas = 12;
        int totalAsignaciones = 5;

        bool esJefe = User.IsInRole("Jefe");
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="sidebar">
            <div class="brand">
                <i class="bi bi-briefcase-fill me-2"></i>
                Plazas Vacantes
            </div>

            <div class="nav flex-column mt-3">

                <!-- Inicio -->
                <a class="nav-link @(controller == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>

                <!-- PLAZAS -->
                <a class="nav-link tree-toggle" data-bs-toggle="collapse" href="#plazas">
                    <i class="bi bi-briefcase"></i> Plazas
                </a>

                @* <div class="collapse @(esPlazas ? "show" : "")" id="plazas"> *@
                <div class="collapse" id="plazas">

                    <a class="nav-link @(controller == "Plazas" && action == "Crear" ? "active" : "")"
                       asp-controller="Plazas" asp-action="Crear">
                        Crear plaza vacante
                    </a>

                    @* <a class="nav-link @(controller=="Asignaciones"?"active":"")"
                       asp-controller="Asignaciones" asp-action="Index">
                        Asignaciones
                        <span class="badge badge-count">@totalAsignaciones</span>
                    </a> *@

                    <a class="nav-link @(controller=="Plazas" && action=="Index"?"active":"")"
                       asp-controller="Plazas" asp-action="Index">
                        Listado de plazas
                        <span class="badge badge-count">@totalPlazas</span>
                    </a>

                    <a class="nav-link"
                       asp-controller="Postulacion" asp-action="Index" target="_blank">
                        Portal Público
                    </a>

                    <a class="nav-link @(controller == "PlazasInternas" ? "active" : "")"
                       asp-controller="PlazasInternas" asp-action="Index">
                        Plazas internas
                    </a>

                    <a class="nav-link @(controller == "Seguimineto" ? "active" : "")"
                       asp-controller="Seguimiento" asp-action="Index">
                        Seguimiento de plazas
                    </a>

                    <!-- Gestión -->
                    <a class="nav-link tree-toggle" data-bs-toggle="collapse" href="#gestion">
                        Gestión de plazas
                    </a>

                    @* <div class="collapse @(controller == "Asignaciones" ? "show" : "")" id="gestion"> *@
                    <div class="collapse" id="gestion">
                        <a class="nav-link @(controller == "Asignaciones" ? "active" : "")"
                           asp-controller="Asignaciones"
                           asp-action="Index">
                            Asignaciones
                            <span class="badge badge-count">@totalAsignaciones</span>
                        </a>
                    </div>

                    <div class="collapse" id="gestion">
                        <a class="nav-link @(controller == "MisPostulaciones" ? "active" : "")"
                           asp-controller="Postulacion"
                           asp-action="MisPostulaciones"
                           target="_blank">
                            Buscar postulaciones
                        </a>
                    </div>
                </div>

                @if (User.IsInRole("Jefe"))
                {
                    <!-- GESTIÓN ADMINISTRATIVA -->
                    <a class="nav-link tree-toggle" data-bs-toggle="collapse" href="#admin">
                        <i class="bi bi-gear"></i>Gestión administrativa
                    </a>

                    <div class="collapse @(controller == "Usuarios" ? "show" : "")" id="admin">

                        <a class="nav-link @(controller == "Usuarios" && action == "Index" ? "active" : "")"
                           asp-controller="Usuarios" asp-action="Index">
                            Usuarios
                        </a>

                        <a class="nav-link @(controller == "Usuarios" && action == "Crear" ? "active" : "")"
                           asp-controller="Usuarios" asp-action="Crear">
                            Crear usuario
                        </a>

                    </div>
                }

                @if (User.IsInRole("Jefe"))
                {
                    <!-- REPORTERÍA -->
                    <a class="nav-link tree-toggle" data-bs-toggle="collapse" href="#reportes">
                        <i class="bi bi-bar-chart"></i> Reportería
                    </a>

                    <div class="collapse @(esReporteria ? "show" : "")" id="reportes">

                        <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Index">
                            Dashboard
                        </a>

                        <a class="nav-link @(controller == "Reportes" ? "active" : "")"
                           asp-controller="Reportes" asp-action="Index">
                            Reportes
                        </a>
                    </div>
                }

                <!-- Salir -->
                <a class="nav-link" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i> Salir
                </a>

            </div>
        </nav>
    }

    <div class="content flex-grow-1">
        <div class="navbar-top shadow-sm d-flex justify-content-between">

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-link d-lg-none" id="sidebarToggle">
                    <i class="bi bi-list fs-1"></i>
                </button>

                <img src="~/images/curridabat-logo.jpg" class="logo-curridabat">
                <span class="fw-semibold">Municipalidad de Curridabat</span>
            </div>

            <div class="user-info">
                <i class="bi bi-person-circle"></i>
                <span>@User.Identity?.Name</span>
            </div>
        </div>

        <main class="mt-4">
            @RenderBody()
        </main>

        <footer class="border-top mt-4">
            © @DateTime.Now.Year - Municipalidad de Curridabat
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // 💾 persistencia
        document.querySelectorAll('.tree-toggle').forEach(el => {
            el.addEventListener('click', () => {
                let id = el.getAttribute('href');
                localStorage.setItem(id, !document.querySelector(id).classList.contains('show'));
            });
        });

        // document.querySelectorAll('.collapse').forEach(el => {
        //     let state = localStorage.getItem('#'+el.id);
        //     if(state === 'true') el.classList.add('show');
        // });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>