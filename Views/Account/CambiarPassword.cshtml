@using GestionPlazasVacantes.DTOs
@model CambiarPasswordDto

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="mb-3 text-center">
                        🔐 Cambiar contraseña
                    </h5>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary()
                        </div>
                    }

                    <form asp-action="CambiarPassword" method="post">

                        <div class="mb-2">
                            <label class="form-label small">Nueva contraseña</label>
                            <input asp-for="NuevaPassword"
                                   type="password"
                                   class="form-control form-control-sm" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Confirmar contraseña</label>
                            <input asp-for="ConfirmarPassword"
                                   type="password"
                                   class="form-control form-control-sm" />
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-primary btn-sm">
                                Guardar
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>