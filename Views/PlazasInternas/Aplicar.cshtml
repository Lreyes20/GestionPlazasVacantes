@model GestionPlazasVacantes.Models.Postulacion
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Formulario de Postulación Interna";
    var plaza = Model?.Plaza; /* as GestionPlazasVacantes.Models.PlazaVacante; */
    Layout = "_Layout";
}



<div class="formulario-postulacion">
    <h4><i class="bi bi-person-badge me-2"></i>Formulario de Postulación</h4>
    <p class="subtitle text-center mb-4">Plaza: <strong>@plaza?.Titulo</strong></p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center fw-semibold">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center fw-semibold">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <form id="formPostulacion" asp-action="Aplicar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Postulante.Id" />
        <input type="hidden" asp-for="Postulante.PlazaVacanteId" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <!-- 🔹 Datos personales -->
        <div class="seccion">
            <h5>1️⃣ Datos Personales</h5>
            <div class="row">
                <div class="col-md-6">
                    <label asp-for="Postulante.NombreCompleto"></label>
                    <input asp-for="Postulante.NombreCompleto" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Postulante.Cedula"></label>
                    <input asp-for="Postulante.Cedula" class="form-control" required />
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-6">
                    <label asp-for="Postulante.Correo"></label>
                    <input asp-for="Postulante.Correo" type="email" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Postulante.Telefono"></label>
                    <input asp-for="Postulante.Telefono" class="form-control" />
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <label asp-for="Postulante.Direccion"></label>
                    <textarea asp-for="Postulante.Direccion" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>

        <!-- 🔹 Información Curricular -->
        <div class="seccion">
            <h5>📄 Información Curricular</h5>

            <label asp-for="Postulante.PerfilProfesional"></label>
            <textarea asp-for="Postulante.PerfilProfesional" class="form-control" rows="3" placeholder="Describe brevemente tu perfil profesional..."></textarea>

            <label asp-for="Postulante.ExperienciaLaboral"></label>
            <textarea asp-for="Postulante.ExperienciaLaboral" class="form-control" rows="3" placeholder="Describe tus experiencias laborales más relevantes..."></textarea>

            <label asp-for="Postulante.FormacionAcademica"></label>
            <textarea asp-for="Postulante.FormacionAcademica" class="form-control" rows="3" placeholder="Incluye tus títulos o grados académicos..."></textarea>

            <label asp-for="Postulante.Habilidades"></label>
            <textarea asp-for="Postulante.Habilidades" class="form-control" rows="2" placeholder="Ejemplo: liderazgo, programación, redacción técnica..."></textarea>

            <label asp-for="Postulante.Idiomas"></label>
            <textarea asp-for="Postulante.Idiomas" class="form-control" rows="2" placeholder="Ejemplo: Español (nativo), Inglés (B2)..."></textarea>

            <label asp-for="Postulante.FormacionComplementaria"></label>
            <textarea asp-for="Postulante.FormacionComplementaria" class="form-control" rows="2" placeholder="Cursos, certificaciones, talleres..."></textarea>

            <label asp-for="Postulante.OtrosDatos"></label>
            <textarea asp-for="Postulante.OtrosDatos" class="form-control" rows="2" placeholder="Cualquier otra información que consideres relevante..."></textarea>
        </div>

        <div class="seccion">
            <h5>📎 Currículum Vitae</h5>
            <p class="text-muted">Podés subir tu currículum en PDF o generarlo automáticamente con los datos del formulario.</p>

            <div class="row align-items-center">
                <div class="col-md-6">
                    <label for="Postulante.curriculum" class="form-label">📄 Subir tu currículum (solo PDF)</label>
                    @* <input type="Postulante.file" name="curriculum" id="curriculum" accept=".pdf" class="form-control" required /> *@
                    <input type="file" name="curriculum" id="curriculum" accept=".pdf" class="form-control" required />
                    <small class="text-muted">Tamaño máximo: 10 MB</small>
                </div>
                <div class="col-md-6 text-center">
                    <p class="mb-2"><strong>O bien</strong></p>
                    <button type="button" id="btnGenerarCV" class="btn btn-outline-primary">
                        <i class="bi bi-file-earmark-pdf"></i> Generar CV Automático
                    </button>
                    <small class="d-block text-muted mt-1">Se generará un PDF con los datos ingresados</small>
                </div>
            </div>
        </div>

        <!-- 🔹 Documentos requeridos -->
        @if (plaza != null && plaza.Documentos != null && plaza.Documentos.Any())
        {
            <div class="seccion mt-4">
                <h5>📚 Documentos Requeridos por la Plaza</h5>

                @for (int i = 0; i < plaza.Documentos.Count; i++)
                {
                    var doc = plaza.Documentos[i];

                    <div class="mb-3">
                        <label class="form-label">
                            @doc.Nombre
                            @if (doc.Obligatorio)
                            {
                                <span class="text-danger">(Obligatorio)</span>
                            }
                        </label>

                        <input type="file"
                               name="Archivos"
                               class="form-control"
                               accept=".pdf,.jpg,.jpeg,.png"
                               @(doc.Obligatorio ? "required" : "") />

                        <!-- 🔥 IMPORTANTE: enviar tipo -->
                        <input type="hidden"
                               name="Tipos"
                               value="@doc.Nombre" />
                    </div>
                }
            </div>
        }

        <!-- 🔹 Declaración bajo juramento -->
        <div class="seccion mt-4 declaracion">
            <h6 class="fw-bold mb-3"><i class="bi bi-shield-check"></i> Declaración bajo juramento</h6>
            <div class="form-check">
                <input class="form-check-input me-2" type="checkbox" id="declaracionJurada" required />
                <label class="form-check-label" for="declaracionJurada">
                    Declaro bajo juramento que la información brindada en este formulario y los documentos adjuntos es veraz,
                    completa y corresponde a mi persona. Entiendo que cualquier falsedad podrá ser motivo de
                    descalificación o anulación de mi postulación.
                </label>
            </div>
        </div>

        <!-- 🔘 Botones -->
        <div class="botones-formulario mt-4">

            <button type="submit" id="btnEnviar" class="btn btn-primary">
                <i class="bi bi-send-check"></i> Enviar Postulación
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        const btnEnviar = document.getElementById("btnEnviar");
        const btnGenerarCV = document.getElementById("btnGenerarCV");

        // ✅ VALIDACIÓN
            btnGenerarCV.addEventListener("click", async () => {

            btnGenerarCV.disabled = true;
            btnGenerarCV.innerText = "Generando...";

            const nombre = document.querySelector('[name="Postulante.NombreCompleto"]')?.value.trim();
            const cedula = document.querySelector('[name="Postulante.Cedula"]')?.value.trim();

            if (!nombre || !cedula) {
                alert("⚠️ Completa nombre y cédula.");
                btnGenerarCV.disabled = false;
                btnGenerarCV.innerText = "Generar CV";
                return;
            }

            const formData = new FormData();

            const campos = [
                'NombreCompleto','Cedula','Correo','Telefono','Direccion',
                'PerfilProfesional','ExperienciaLaboral','FormacionAcademica',
                'Habilidades','Idiomas','FormacionComplementaria','OtrosDatos'
            ];

            campos.forEach(campo => {
                const input = document.querySelector(`[name="Postulante.${campo}"]`);
                if (input && input.value) {
                    formData.append(campo, input.value);
                }
            });

            try {
                const response = await fetch('@Configuration["Api:BaseUrl"]api/plazas-internas/generar-cv', {
                    method: 'POST',
                    body: formData
                });

                // if (!response.ok) {
                //     alert("❌ Error generando PDF");
                //     return;
                //     return;
                // }
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error("ERROR API:", errorText);
                    alert(errorText);
                    return;
                }

                const blob = await response.blob();

                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `CV_${nombre.replaceAll(" ", "_")}.pdf`;
                document.body.appendChild(a);
                a.click();
                a.remove();

                } catch (error) {
                    console.error("ERROR REAL:", error);
                    alert(error.message);
                } finally {
                btnGenerarCV.disabled = false;
                btnGenerarCV.innerText = "Generar CV";
            }
        });

    });
</script>