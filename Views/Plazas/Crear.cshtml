@using GestionPlazasVacantes.Models
@model GestionPlazasVacantes.DTOs.PlazaDto

@{
    ViewData["Title"] = "Formulario de Creación de Plaza Vacante";
}

<div class="formulario-plaza">
    <h4><i class="bi bi-clipboard2-check me-2"></i>Formulario de Creación de Plaza Vacante</h4>
    <p class="subtitle">Complete los datos solicitados cuidadosamente antes de guardar.</p>

    <form asp-action="Crear" method="post" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()

        <!-- Encabezado del concurso -->
        <div class="encabezado-concurso">
            <div class="row g-3 align-items-center justify-content-center">
                <div class="col-md-4">
                    <label asp-for="TipoConcursoEnum"></label>
                    <select asp-for="TipoConcursoEnum"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<TipoConcursoEnum>()">
                    </select>
                    <span asp-validation-for="TipoConcursoEnum" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="NumeroConcurso"></label>
                    <input asp-for="NumeroConcurso" class="form-control" placeholder="Ej. 04-2025" />
                    <span asp-validation-for="NumeroConcurso" class="text-danger"></span>
                </div>
            </div>

            <div id="previewConcurso" class="mt-4">
                <h5 id="tituloConcurso">CONCURSO N° —</h5>
                <p>Requiere contratar los servicios de:</p>
            </div>
        </div>

        <!-- Sección 1 -->
        <div class="seccion">
            <h5>1️⃣ Información General</h5>
            <div class="row">
                <div class="col-md-6">
                    <label asp-for="Titulo"></label>
                    <input asp-for="Titulo" class="form-control" placeholder="Ejemplo: Ingeniero Civil" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Departamento"></label>
                    <select asp-for="Departamento" class="form-select">
                        <option value="">Seleccione un departamento...</option>
                        <option value="Tecnologías de Información">Tecnologías de Información</option>
                        <option value="Recursos Humanos">Recursos Humanos</option>
                        <option value="Finanzas">Finanzas</option>
                        <option value="Operaciones">Operaciones</option>
                        <option value="Logística">Logística</option>
                        <option value="Ventas">Ventas</option>
                        <option value="Compras">Compras</option>
                        <option value="Legal">Legal</option>
                        <option value="Mercadeo">Mercadeo</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Sección 2 -->
        <div class="seccion">
            <h5>2️⃣ Condiciones del Puesto</h5>

            <div class="row">
                <div class="col-md-6">
                    <label asp-for="SalarioCompuesto"></label>
                    <input asp-for="SalarioCompuesto" type="number" step="0.01" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="SalarioGlobal"></label>
                    <input asp-for="SalarioGlobal" type="number" step="0.01" class="form-control" />
                </div>
            </div>

            <div class="row mt-3">

                <div class="col-md-6">
                    <label asp-for="Horario"></label>
                    <input asp-for="Horario"
                           class="form-control"
                           placeholder="Ej. Lunes a Viernes 8:00am - 5:00pm" />
                    <span asp-validation-for="Horario" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaLimite"></label>
                    <input asp-for="FechaLimite"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="FechaLimite" class="text-danger"></span>
                </div>

            </div>

        </div>

        <!-- Sección 3 -->
        <div class="seccion">
            <h5>3️⃣ Requisitos y Observaciones</h5>

            <label>Requisitos</label>

            <!-- 🔥 FILTRO SIN SELECT2 -->
            <input type="text"
                   id="filtroRequisitos"
                   class="form-control form-control-sm mb-2"
                   placeholder="🔎 Buscar requisito..." />

            <!-- 🔥 LISTA CON CHECKBOXES UX PRO -->
            <div id="listaRequisitos"
                 class="border rounded p-3 bg-light"
                 style="max-height:260px; overflow-y:auto;">

                @foreach (var r in ViewBag.RequisitosCatalogo as List<GestionPlazasVacantes.DTOs.CatalogoDto>)
                {
                    <div class="form-check requisito-item mb-2">
                        <input class="form-check-input"
                               type="checkbox"
                               name="RequisitosSeleccionados"
                               value="@r.Nombre"
                               id="req_@r.Id" />

                        <label class="form-check-label" for="req_@r.Id">
                            @r.Nombre
                        </label>
                    </div>
                }
            </div>

            <!-- fallback -->
            @* <textarea asp-for="Requisitos" class="form-control mt-2"></textarea> *@

            <div class="mt-3">
                <label asp-for="Observaciones"></label>
                <textarea asp-for="Observaciones" class="form-control"></textarea>
            </div>
        </div>

        <!-- Sección 4 -->
        <div class="seccion">
            <h5>4️⃣ Documentos que se solicitarán</h5>

            @foreach (var d in ViewBag.DocumentosCatalogo as List<GestionPlazasVacantes.DTOs.CatalogoDto>)
            {
                <div class="card p-2 mb-2 shadow-sm documento-item">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <!-- 🔥 Checkbox visual, NO se envía directo al modelo -->
                            <input type="checkbox"
                                   class="doc-check"
                                   id="doc_@d.Id" />

                            <label for="doc_@d.Id">
                                <strong>@d.Nombre</strong>
                            </label>

                            <!-- 🔥 Campos reales del modelo. Van deshabilitados hasta que se seleccione -->
                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos.Index"
                                   value="@d.Id"
                                   disabled />

                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos[@d.Id].Id"
                                   value="@d.Id"
                                   disabled />

                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos[@d.Id].Nombre"
                                   value="@d.Nombre"
                                   disabled />
                        </div>

                        <div>
                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos[@d.Id].Obligatorio"
                                   value="false"
                                   disabled />

                            <input type="checkbox"
                                   class="doc-obligatorio doc-field"
                                   name="Documentos[@d.Id].Obligatorio"
                                   value="true"
                                   disabled />

                            <small class="text-danger">Obligatorio</small>
                        </div>

                    </div>

                </div>
            }
        </div>

        <div class="botones-formulario mt-4">
            <button type="submit" class="btn btn-primary">
                Guardar Plaza
            </button>
        </div>
    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // 🔥 FILTRO DE REQUISITOS SIN SELECT2
        const filtroRequisitos = document.getElementById("filtroRequisitos");

        if (filtroRequisitos) {
            filtroRequisitos.addEventListener("keyup", function () {
                const filtro = this.value.toLowerCase();
                const items = document.querySelectorAll(".requisito-item");

                items.forEach(item => {
                    const texto = item.innerText.toLowerCase();
                    item.style.display = texto.includes(filtro) ? "" : "none";
                });
            });
        }

        // 🔥 DOCUMENTOS DINÁMICOS
        document.querySelectorAll(".documento-item").forEach(item => {

            const check = item.querySelector(".doc-check");
            const obligatorio = item.querySelector(".doc-obligatorio");
            const fields = item.querySelectorAll(".doc-field");

            function sincronizarDocumento() {
                const seleccionado = check.checked;

                fields.forEach(field => {
                    field.disabled = !seleccionado;
                });

                if (!seleccionado) {
                    obligatorio.checked = false;
                }
            }

            check.addEventListener("change", sincronizarDocumento);
            sincronizarDocumento();
        });

        // 🔥 VALIDACIÓN DOCUMENTOS
        document.querySelector("form").addEventListener("submit", function (e) {

            const items = document.querySelectorAll(".documento-item");

            for (let item of items) {

                const seleccionado = item.querySelector(".doc-check");
                const obligatorio = item.querySelector(".doc-obligatorio");

                if (obligatorio.checked && !seleccionado.checked) {
                    e.preventDefault();
                    alert("⚠️ Hay documentos obligatorios que no están seleccionados.");
                    return;
                }
            }
        });
    </script>
}