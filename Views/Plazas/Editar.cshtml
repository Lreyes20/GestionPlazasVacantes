@using GestionPlazasVacantes.Models
@model GestionPlazasVacantes.DTOs.PlazaDto

@{
    ViewData["Title"] = "Editar Plaza Vacante";
}

<div class="formulario-plaza">
    <h4><i class="bi bi-pencil-square me-2"></i>Editar Plaza Vacante</h4>
    <p class="subtitle">Actualice los campos necesarios y guarde los cambios.</p>

    <form asp-action="Editar" method="post" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <!-- Encabezado -->
        <div class="encabezado-concurso">
            <div class="row g-3 align-items-center justify-content-center">
                <div class="col-md-4">
                    <label asp-for="TipoConcursoEnum"></label>
                    <select asp-for="TipoConcursoEnum"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<TipoConcursoEnum>()">
                    </select>
                    <span asp-validation-for="TipoConcursoEnum" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="NumeroConcurso"></label>
                    <input asp-for="NumeroConcurso" class="form-control" />
                </div>
            </div>

            <div id="previewConcurso" class="mt-4">
                <h5>
                    CONCURSO @Model.TipoConcursoEnum.ToString().ToUpper()
                    N° @Model.NumeroConcurso
                </h5>
            </div>
        </div>

        <!-- Sección 1 -->
        <div class="seccion">
            <h5>1️⃣ Información General</h5>
            <div class="row">
                <div class="col-md-6">
                    <label asp-for="Titulo"></label>
                    <input asp-for="Titulo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Departamento"></label>
                    <select asp-for="Departamento" class="form-select">
                        <option value="">Seleccione un departamento...</option>
                        @{
                            var deptosEditar = ViewBag.DepartamentosCatalogo as List<GestionPlazasVacantes.DTOs.CatalogoDto>;
                        }
                        @if (deptosEditar != null)
                        {
                            foreach (var depto in deptosEditar.Where(d => d.Activo).OrderBy(d => d.Nombre))
                            {
                                <option value="@depto.Nombre">@depto.Nombre</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Sección 2 (🔥 CORREGIDA) -->
        <div class="seccion">
            <h5>2️⃣ Condiciones del Puesto</h5>

            <div class="row">
                <div class="col-md-6">
                    <label asp-for="SalarioCompuesto"></label>
                    <input asp-for="SalarioCompuesto" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="SalarioGlobal"></label>
                    <input asp-for="SalarioGlobal" class="form-control" />
                </div>
            </div>

            <!-- 🔥 NUEVO -->
            <div class="row mt-3">
                <div class="col-md-6">
                    <label asp-for="Horario"></label>
                    <input asp-for="Horario" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaLimite"></label>
                    <input asp-for="FechaLimite"
                           type="date"
                           class="form-control" />
                </div>
            </div>
        </div>

        <!-- Sección 3 (🔥 SIN SELECT2) -->
        <div class="seccion">
            <h5>3️⃣ Requisitos y Observaciones</h5>

            <label>Requisitos</label>

            <!-- 🔥 FILTRO -->
            <input type="text"
                   id="filtroRequisitos"
                   class="form-control form-control-sm mb-2"
                   placeholder="🔎 Buscar requisito..." />

            @{
                var seleccionados = Model.Requisitos?
                .Split(",", StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .ToList() ?? new List<string>();
            }

            <!-- 🔥 LISTA UX PRO -->
            <div id="listaRequisitos"
                 class="border rounded p-3 bg-light"
                 style="max-height:260px; overflow-y:auto;">

                @foreach (var r in ViewBag.RequisitosCatalogo as List<GestionPlazasVacantes.DTOs.CatalogoDto>)
                {
                    var selected = seleccionados.Contains(r.Nombre);

                    <div class="form-check requisito-item mb-2">
                        <input class="form-check-input"
                               type="checkbox"
                               name="RequisitosSeleccionados"
                               value="@r.Nombre"
                               id="req_@r.Id"
                               @(selected ? "checked" : "") />

                        <label class="form-check-label" for="req_@r.Id">
                            @r.Nombre
                        </label>
                    </div>
                }
            </div>

            <!-- fallback -->
            <textarea asp-for="Requisitos" class="form-control mt-2"></textarea>

            <div class="mt-3">
                <label asp-for="Observaciones"></label>
                <textarea asp-for="Observaciones" class="form-control"></textarea>
            </div>
        </div>

        <!-- Sección 4 -->
        <div class="seccion">
            <h5>📎 Documentos requeridos</h5>

            @foreach (var d in ViewBag.DocumentosCatalogo as List<GestionPlazasVacantes.DTOs.CatalogoDto>)
            {
                var docExistente = Model.Documentos?.FirstOrDefault(x =>
                (x.Id > 0 && x.Id == d.Id) || x.Nombre == d.Nombre);

                var seleccionado = docExistente != null;
                var obligatorio = docExistente?.Obligatorio == true;

                <div class="card p-2 mb-2 shadow-sm documento-item">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <!-- 🔥 Checkbox visual, NO se envía directo al modelo -->
                            <input type="checkbox"
                                   class="doc-check"
                                   id="doc_@d.Id"
                                   @(seleccionado ? "checked" : "") />

                            <label for="doc_@d.Id">
                                <strong>@d.Nombre</strong>
                            </label>

                            <!-- 🔥 Campos reales del modelo -->
                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos.Index"
                                   value="@d.Id"
                                   disabled="@(seleccionado ? null : "disabled")" />

                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos[@d.Id].Id"
                                   value="@d.Id"
                                   disabled="@(seleccionado ? null : "disabled")" />

                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos[@d.Id].Nombre"
                                   value="@d.Nombre"
                                   disabled="@(seleccionado ? null : "disabled")" />
                        </div>

                        <div>
                            <input type="checkbox"
                                   class="doc-obligatorio doc-field"
                                   name="Documentos[@d.Id].Obligatorio"
                                   value="true"
                                   @(obligatorio ? "checked" : "")
                                   disabled="@(seleccionado ? null : "disabled")" />

                            <input type="hidden"
                                   class="doc-field"
                                   name="Documentos[@d.Id].Obligatorio"
                                   value="false"
                                   disabled="@(seleccionado ? null : "disabled")" />

                            <small class="text-danger">Obligatorio</small>
                        </div>

                    </div>

                </div>
            }
        </div>

        <div class="botones-formulario mt-4">
            <button type="submit" class="btn btn-primary">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // 🔥 FILTRO REQUISITOS
        const filtroRequisitosEditar = document.getElementById("filtroRequisitos");

        if (filtroRequisitosEditar) {
            filtroRequisitosEditar.addEventListener("keyup", function () {

                const filtro = this.value.toLowerCase();
                const items = document.querySelectorAll(".requisito-item");

                items.forEach(item => {
                    const texto = item.innerText.toLowerCase();
                    item.style.display = texto.includes(filtro) ? "" : "none";
                });

            });
        }

        // 🔥 DOCUMENTOS DINÁMICOS
        document.querySelectorAll(".documento-item").forEach(item => {

            const check = item.querySelector(".doc-check");
            const obligatorio = item.querySelector(".doc-obligatorio");
            const fields = item.querySelectorAll(".doc-field");

            function sincronizarDocumento() {
                const seleccionado = check.checked;

                fields.forEach(field => {
                    field.disabled = !seleccionado;
                });

                if (!seleccionado) {
                    obligatorio.checked = false;
                }
            }

            check.addEventListener("change", sincronizarDocumento);
            sincronizarDocumento();
        });

        // 🔥 VALIDACIÓN DOCUMENTOS
        document.querySelector("form").addEventListener("submit", function (e) {

            const items = document.querySelectorAll(".documento-item");

            for (let item of items) {

                const seleccionado = item.querySelector(".doc-check");
                const obligatorio = item.querySelector(".doc-obligatorio");

                if (obligatorio.checked && !seleccionado.checked) {
                    e.preventDefault();
                    alert("⚠️ Hay documentos obligatorios que no están seleccionados.");
                    return;
                }
            }
        });
    </script>
}