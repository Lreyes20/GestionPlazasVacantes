@model IEnumerable<GestionPlazasVacantes.DTOs.PlazaDto>

@{
    ViewData["Title"] = "Plazas Disponibles";
    var plazasVigentes = Model.Where(p => p.FechaLimite > DateTime.Now).ToList();
}

<style>
    /* ── Cards de plazas (público) ── */
    .plaza-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.2rem;
    }

    .plaza-card {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
    }

    .plaza-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 18px rgba(0,0,0,0.13);
    }

    .plaza-card h5 {
        color: #FF8200;
        font-weight: 700;
        margin-bottom: 0.3rem;
    }

    .plaza-card .subtitulo {
        font-size: 0.88rem;
        color: #6c757d;
    }

    .plaza-card p {
        font-size: 0.9rem;
        margin-bottom: 0.3rem;
    }

    .plaza-card strong {
        color: #435563;
    }

    .plaza-card .bloque-info {
        background-color: #f8f9fa;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        margin-bottom: 0.5rem;
    }

    .plaza-card .bloque-info strong {
        display: block;
        margin-bottom: 0.15rem;
        font-size: 0.82rem;
    }

    .plaza-card .acciones {
        padding: 0.75rem 1rem;
        border-top: 1px solid #eee;
    }

    .no-plazas {
        text-align: center;
        padding: 2rem;
        color: #6c757d;
        font-size: 1.1rem;
    }

    @@media (max-width: 991px) {
        .plaza-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 576px) {
        .plaza-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="container-fluid px-4">

    <!-- 🔶 HEADER INSTITUCIONAL -->
    <div class="mb-4 p-4 rounded shadow-sm bg-white border-start border-4 border-warning">
        <h2 class="mb-1" style="color:#435563;">
            💼 Plazas Disponibles para Postulación
        </h2>
        <small class="text-muted">
            Municipalidad de Curridabat • Portal de Empleo
        </small>
    </div>

    @if (plazasVigentes.Any())
    {
        <!-- 🔍 FILTROS -->
        <div class="row mb-4 g-3">
            <div class="col-md-8">
                <input type="text" id="busquedaPlaza" class="form-control shadow-sm"
                       placeholder="🔍 Buscar por título, departamento, requisitos u observaciones..." />
            </div>
            <div class="col-md-4">
                <select id="filtroDepartamento" class="form-select shadow-sm">
                    <option value="">Todos los departamentos</option>
                    @foreach (var depto in plazasVigentes
                                    .Where(p => !string.IsNullOrWhiteSpace(p.Departamento))
                                    .Select(p => p.Departamento)
                                    .Distinct()
                                    .OrderBy(x => x))
                    {
                        <option value="@depto.ToLower()">@depto</option>
                    }
                </select>
            </div>
        </div>
    }

    @if (!plazasVigentes.Any())
    {
        <p class="no-plazas">🚫 No hay plazas disponibles en este momento.</p>
    }
    else
    {
        <div class="plaza-grid" id="contenedorPlazas">

            @foreach (var plaza in plazasVigentes)
            {
                var observaciones = plaza.Observaciones ?? "";
                var requisitos = plaza.Requisitos ?? "";
                var departamento = plaza.Departamento ?? "";
                var horario = plaza.Horario ?? "";
                var titulo = plaza.Titulo ?? "";

                <div class="plaza-card plaza-filtrable"
                     data-titulo="@titulo.ToLower()"
                     data-departamento="@departamento.ToLower()"
                     data-requisitos="@requisitos.ToLower()"
                     data-observaciones="@observaciones.ToLower()">

                    <div style="padding:1rem;">
                        <!-- HEADER CARD -->
                        <h5>@plaza.Titulo</h5>
                        <p class="subtitulo">
                            <i class="bi bi-building"></i> @plaza.TipoConcursoEnum Nº @plaza.NumeroConcurso
                        </p>

                        <p><strong>Departamento:</strong> @plaza.Departamento</p>
                        <p><strong>Horario:</strong> @plaza.Horario</p>

                        <!-- REQUISITOS -->
                        @if (!string.IsNullOrWhiteSpace(plaza.Requisitos))
                        {
                            <div class="bloque-info">
                                <strong>Requisitos:</strong>
                                <p class="mb-0">@plaza.Requisitos</p>
                            </div>
                        }

                        <!-- OBSERVACIONES -->
                        @if (!string.IsNullOrEmpty(plaza.Observaciones))
                        {
                            <div class="bloque-info">
                                <strong>Observaciones:</strong>
                                <p class="mb-0">@plaza.Observaciones</p>
                            </div>
                        }

                        <!-- DOCUMENTOS REQUERIDOS -->
                        @if (plaza.Documentos != null && plaza.Documentos.Any())
                        {
                            <div class="bloque-info">
                                <strong>📎 Documentos requeridos:</strong>
                                <ul class="mb-0 ps-3">
                                    @foreach (var doc in plaza.Documentos)
                                    {
                                        <li>
                                            @doc.Nombre
                                            @if (doc.Obligatorio)
                                            {
                                                <span class="badge bg-danger text-dark ms-1" style="font-size:0.7em">Obligatorio</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- SALARIO -->
                        <div class="bloque-info">
                            <strong>Salario:</strong>
                            <p class="mb-0">Compuesto: ₡@plaza.SalarioCompuesto.ToString("N2")</p>
                            <p class="mb-0">Global: ₡@plaza.SalarioGlobal.ToString("N2")</p>
                        </div>

                        <!-- FECHA -->
                        <div class="bloque-info">
                            <strong>Fecha límite:</strong>
                            <p class="mb-0">📅 @plaza.FechaLimite.ToString("dd/MM/yyyy")</p>
                            <p class="mb-0">🕒 @plaza.FechaLimite.ToString("hh:mm tt")</p>
                        </div>

                        <p class="text-muted mt-2">
                            <small>📢 Publicada el @plaza.FechaCreacion.ToString("dd/MM/yyyy")</small>
                        </p>
                    </div>

                    <!-- BOTÓN -->
                    <div class="acciones">
                        <a asp-controller="Postulacion"
                           asp-action="Aplicar"
                           asp-route-id="@plaza.Id"
                           class="btn btn-warning w-100 fw-bold shadow-sm">
                            <i class="bi bi-pencil-square"></i> Postularme
                        </a>
                    </div>
                </div>
            }
        </div>

        <div id="mensajeSinResultados" class="alert alert-secondary text-center mt-4" style="display:none;">
            🚫 No se encontraron plazas con esos filtros.
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const inputBusqueda = document.getElementById("busquedaPlaza");
            const filtroDepartamento = document.getElementById("filtroDepartamento");
            const cards = document.querySelectorAll(".plaza-filtrable");
            const mensajeSinResultados = document.getElementById("mensajeSinResultados");

            function filtrarPlazas() {
                const texto = (inputBusqueda?.value || "").toLowerCase().trim();
                const departamento = (filtroDepartamento?.value || "").toLowerCase().trim();

                let visibles = 0;

                cards.forEach(card => {
                    const titulo = card.dataset.titulo || "";
                    const depto = card.dataset.departamento || "";
                    const requisitos = card.dataset.requisitos || "";
                    const observaciones = card.dataset.observaciones || "";

                    const coincideTexto =
                        !texto ||
                        titulo.includes(texto) ||
                        depto.includes(texto) ||
                        requisitos.includes(texto) ||
                        observaciones.includes(texto);

                    const coincideDepartamento =
                        !departamento || depto === departamento;

                    if (coincideTexto && coincideDepartamento) {
                        card.style.display = "";
                        visibles++;
                    } else {
                        card.style.display = "none";
                    }
                });

                mensajeSinResultados.style.display = visibles === 0 ? "block" : "none";
            }

            inputBusqueda?.addEventListener("input", filtrarPlazas);
            filtroDepartamento?.addEventListener("change", filtrarPlazas);
        });
    </script>
}