@model IEnumerable<GestionPlazasVacantes.Models.PlazaVacante>

@{
    ViewData["Title"] = "Plazas Disponibles";
    var plazasVigentes = Model.Where(p => p.FechaLimite > DateTime.Now).ToList();
}

<div class="container-fluid px-4">
    <h2 class="titulo-pagina">💼 Plazas Disponibles para Postulación</h2>

    @if (plazasVigentes.Any())
    {
        <div class="row mb-4 g-3">
            <div class="col-md-8">
                <input type="text" id="busquedaPlaza" class="form-control"
                       placeholder="🔍 Buscar por título, departamento, requisitos u observaciones..." />
            </div>
            <div class="col-md-4">
                <select id="filtroDepartamento" class="form-select">
                    <option value="">Todos los departamentos</option>
                    @foreach (var depto in plazasVigentes
                                    .Where(p => !string.IsNullOrWhiteSpace(p.Departamento))
                                    .Select(p => p.Departamento)
                                    .Distinct()
                                    .OrderBy(x => x))
                    {
                        <option value="@depto.ToLower()">@depto</option>
                    }
                </select>
            </div>
        </div>
    }

    @if (!plazasVigentes.Any())
    {
        <p class="no-plazas">🚫 No hay plazas disponibles en este momento.</p>
    }
    else
    {
        <div class="plaza-grid" id="contenedorPlazas">
            @foreach (var plaza in plazasVigentes)
            {
                var observaciones = plaza.Observaciones ?? "";
                var requisitos = plaza.Requisitos ?? "";
                var departamento = plaza.Departamento ?? "";
                var horario = plaza.Horario ?? "";
                var titulo = plaza.Titulo ?? "";

                <div class="plaza-card plaza-filtrable"
                     data-titulo="@titulo.ToLower()"
                     data-departamento="@departamento.ToLower()"
                     data-requisitos="@requisitos.ToLower()"
                     data-observaciones="@observaciones.ToLower()">

                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-1">@plaza.Titulo</h5>
                            <span class="badge bg-primary-subtle text-primary-emphasis">
                                @plaza.TipoConcurso
                            </span>
                        </div>

                        <p class="subtitulo">
                            <i class="bi bi-briefcase"></i> @plaza.TipoConcurso Nº @plaza.NumeroConcurso
                        </p>

                        <p><strong>Departamento:</strong> @plaza.Departamento</p>
                        <p><strong>Horario:</strong> @plaza.Horario</p>

                        <div class="bloque-info">
                            <strong>Requisitos:</strong>
                            <p>@plaza.Requisitos</p>
                        </div>

                        @if (!string.IsNullOrEmpty(plaza.Observaciones))
                        {
                            <div class="bloque-info">
                                <strong>Observaciones:</strong>
                                <p>@plaza.Observaciones</p>
                            </div>
                        }

                        <div class="bloque-info">
                            <strong>Salario:</strong>
                            <p>Compuesto: ₡@plaza.SalarioCompuesto.ToString("N2")</p>
                            <p>Global: ₡@plaza.SalarioGlobal.ToString("N2")</p>
                        </div>

                        <div class="bloque-info">
                            <strong>Fecha límite:</strong>
                            <p>📅 @plaza.FechaLimite.ToString("dd/MM/yyyy")</p>
                            <p>🕒 @plaza.FechaLimite.ToString("hh:mm tt")</p>
                        </div>

                        <p class="text-muted mt-2">
                            <small>📢 Publicada el @plaza.FechaCreacion.ToString("dd/MM/yyyy") a las @plaza.FechaCreacion.ToString("hh:mm tt")</small>
                        </p>
                    </div>

                    <div class="acciones">
                        <a asp-controller="Postulacion" asp-action="Aplicar" asp-route-id="@plaza.Id"
                           class="btn btn-primary w-100">
                            <i class="bi bi-pencil-square"></i> Postularme
                        </a>
                    </div>
                </div>
            }
        </div>

        <div id="mensajeSinResultados" class="no-plazas" style="display:none;">
            🚫 No se encontraron plazas con esos filtros.
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const inputBusqueda = document.getElementById("busquedaPlaza");
            const filtroDepartamento = document.getElementById("filtroDepartamento");
            const cards = document.querySelectorAll(".plaza-filtrable");
            const mensajeSinResultados = document.getElementById("mensajeSinResultados");

            function filtrarPlazas() {
                const texto = (inputBusqueda?.value || "").toLowerCase().trim();
                const departamento = (filtroDepartamento?.value || "").toLowerCase().trim();

                let visibles = 0;

                cards.forEach(card => {
                    const titulo = card.dataset.titulo || "";
                    const depto = card.dataset.departamento || "";
                    const requisitos = card.dataset.requisitos || "";
                    const observaciones = card.dataset.observaciones || "";

                    const coincideTexto =
                        !texto ||
                        titulo.includes(texto) ||
                        depto.includes(texto) ||
                        requisitos.includes(texto) ||
                        observaciones.includes(texto);

                    const coincideDepartamento =
                        !departamento || depto === departamento;

                    if (coincideTexto && coincideDepartamento) {
                        card.style.display = "";
                        visibles++;
                    } else {
                        card.style.display = "none";
                    }
                });

                mensajeSinResultados.style.display = visibles === 0 ? "block" : "none";
            }

            inputBusqueda?.addEventListener("input", filtrarPlazas);
            filtroDepartamento?.addEventListener("change", filtrarPlazas);
        });
    </script>
}